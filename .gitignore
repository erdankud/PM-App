# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Local databases and env
server/*.db
server/*.db-wal
server/*.db-shm
server/test-*.db*
.env
.env.local
# Резервные копии .env — в них лежит заполненный ключ провайдера.
.env.bak*

# macOS / Xcode
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.ipa
*.dSYM.zip

# Node (not used yet, but keeps stray installs out)
node_modules/

# Аудиоверсии уроков и голос синтеза: генерируется скриптом, в репозиторий
# не кладётся — голос весит 63 МБ, корпус в mp3 около 170 МБ.
server/var/
.neon

# Сторонние скиллы: ставятся `npx skills add`, воспроизводятся из skills-lock.json.
# В репозиторий не кладутся — это чужой текст (в apple-design 1.4 МБ HIG
# дословно), а лок-файл и так знает, откуда его взять.
.agents/
.claude/skills/apple-design
