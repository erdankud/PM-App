# Copy to server/.env and edit. Never commit a filled-in .env.

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
# Postgres in docker-compose; SQLite is the zero-setup default if you omit this.
# DATABASE_URL=postgresql+psycopg2://pmcoach:pmcoach@localhost:5432/pmcoach

# --- Auth -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=60

# Sign in with Apple. APPLE_CLIENT_ID is your app's bundle identifier (or the
# Services ID). Without it, POST /v1/auth/apple returns 503 rather than
# pretending to verify anything.
# APPLE_CLIENT_ID=com.yourcompany.pmthinkingcoach

# Dev-only identity path used by the iOS client until Apple auth is configured.
# MUST be false in production - the server refuses to boot otherwise.
ALLOW_DEV_AUTH=true

# --- AI evaluation ----------------------------------------------------------
# The key lives here and nowhere else. It is never sent to, embedded in, or
# proxied through the iOS client.
#
# Providers with a free tier:
#   gemini      https://aistudio.google.com/apikey
#               EVALUATOR_MODEL=gemini-2.0-flash
#   groq        https://console.groq.com/keys
#               EVALUATOR_MODEL=llama-3.3-70b-versatile
#   openrouter  https://openrouter.ai/keys
#               EVALUATOR_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Paid: anthropic, openai
# Development stub (NOT AI, refuses to run in production): mock
EVALUATOR_PROVIDER=mock
# EVALUATOR_API_KEY=
# EVALUATOR_MODEL=
# EVALUATOR_BASE_URL=
EVALUATOR_TIMEOUT_SECONDS=45
EVALUATOR_MAX_ATTEMPTS=3
EVALUATIONS_PER_USER_PER_DAY=20

# --- Worker -----------------------------------------------------------------
# true  = the API process also runs the evaluation worker (simplest locally)
# false = run `python -m app.worker` as a separate process
RUN_INLINE_WORKER=true
WORKER_POLL_SECONDS=1.5
