{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pm-thinking-coach.app/schemas/scenario.schema.json",
  "title": "PM Thinking Coach scenario",
  "description": "Authored practice scenario. Content is immutable per (id, version) once published (spec §11, §14).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "status",
    "title",
    "summary",
    "estimatedMinutes",
    "level",
    "primarySkill",
    "secondarySkills",
    "tags",
    "brief",
    "evidenceCards",
    "decisionPrompt",
    "decisionOptions",
    "rubric",
    "learnTakeaway",
    "qaSubmissions"
  ],
  "definitions": {
    "skillKey": {
      "type": "string",
      "enum": [
        "product_sense",
        "analytics",
        "user_research",
        "prioritization",
        "execution",
        "communication"
      ]
    },
    "signalMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product_sense": { "$ref": "#/definitions/signalList" },
        "analytics": { "$ref": "#/definitions/signalList" },
        "user_research": { "$ref": "#/definitions/signalList" },
        "prioritization": { "$ref": "#/definitions/signalList" },
        "execution": { "$ref": "#/definitions/signalList" },
        "communication": { "$ref": "#/definitions/signalList" }
      }
    },
    "signalList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 10, "maxLength": 240 }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 4,
      "maxLength": 64
    },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "type": "string", "enum": ["draft", "published", "retired"] },
    "title": { "type": "string", "minLength": 8, "maxLength": 90 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 220 },
    "estimatedMinutes": { "type": "integer", "minimum": 3, "maximum": 15 },
    "level": { "type": "string", "enum": ["foundation", "developing", "advanced"] },
    "primarySkill": { "$ref": "#/definitions/skillKey" },
    "secondarySkills": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/skillKey" }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "company", "context", "objective", "constraints", "task"],
      "properties": {
        "role": { "type": "string", "minLength": 10, "maxLength": 200 },
        "company": { "type": "string", "minLength": 10, "maxLength": 260 },
        "context": { "type": "string", "minLength": 40, "maxLength": 900 },
        "objective": { "type": "string", "minLength": 20, "maxLength": 300 },
        "constraints": { "type": "string", "minLength": 20, "maxLength": 400 },
        "task": { "type": "string", "minLength": 20, "maxLength": 300 }
      }
    },
    "evidenceCards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "type", "order", "content"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 60 },
          "type": {
            "type": "string",
            "enum": ["quantitative", "qualitative", "technical", "business"]
          },
          "order": { "type": "integer", "minimum": 1, "maximum": 4 },
          "content": { "type": "string", "minLength": 60, "maxLength": 1200 }
        }
      }
    },
    "decisionPrompt": { "type": "string", "minLength": 20, "maxLength": 300 },
    "decisionOptions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description", "consequence", "decisionPoints", "rubricNote"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 5, "maxLength": 100 },
          "description": { "type": "string", "minLength": 30, "maxLength": 320 },
          "consequence": {
            "type": "string",
            "minLength": 80,
            "maxLength": 1200,
            "description": "Authored outcome text shown immediately after submit. Never model-generated (spec §10.9, P0-08)."
          },
          "decisionPoints": {
            "type": "integer",
            "minimum": 0,
            "maximum": 25,
            "description": "Author weight for the 0-25 'Decision quality' scoring component (spec §12)."
          },
          "rubricNote": { "type": "string", "minLength": 20, "maxLength": 400 }
        }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceReasoning", "evidenceSignals", "positiveSignals", "negativeSignals"],
      "properties": {
        "referenceReasoning": { "type": "string", "minLength": 80, "maxLength": 1200 },
        "evidenceSignals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 10, "maxLength": 240 }
        },
        "positiveSignals": { "$ref": "#/definitions/signalMap" },
        "negativeSignals": { "$ref": "#/definitions/signalMap" }
      }
    },
    "learnTakeaway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body"],
      "properties": {
        "title": { "type": "string", "minLength": 5, "maxLength": 80 },
        "body": { "type": "string", "minLength": 60, "maxLength": 600 }
      }
    },
    "qaSubmissions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "Editorial QA fixtures: at least one strong, one weak, one defensible alternative (spec §11). Rationale length matches the product's own 30-600 character limit (spec §10.8), so every fixture is something a user could actually submit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "optionId", "evidenceIds", "rationale", "expectedScoreMin", "expectedScoreMax"],
        "properties": {
          "label": {
            "type": "string",
            "enum": ["strong", "weak", "defensible_alternative"]
          },
          "optionId": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string" } },
          "rationale": { "type": "string", "minLength": 30, "maxLength": 600 },
          "expectedScoreMin": { "type": "integer", "minimum": 0, "maximum": 100 },
          "expectedScoreMax": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
