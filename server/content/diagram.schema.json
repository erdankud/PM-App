{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagram",
  "description": "Схема как структура: клиент рендерит её сам (спека SD §3.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "nodes",
    "edges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "layerOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "client",
              "service",
              "store",
              "cache",
              "queue",
              "external",
              "boundary",
              "actor"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sync",
              "async",
              "data"
            ]
          },
          "label": {
            "type": "string"
          }
        }
      }
    }
  }
}
